PORT=5000
NODE_ENV=development

# MongoDB Atlas or local MongoDB
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/shree-ramdev-hotel?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

